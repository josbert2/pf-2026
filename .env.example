# Copy to .env and adjust. .env is gitignored.

# Public site URL — used for canonical/OG tags. Change to your real domain.
SITE_URL=http://localhost:8080

# --- Host ports ---
WEB_PORT=8080
API_PORT=3001
DB_PORT_HOST=3307
ADMINER_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MySQL ---
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio_dev_pw
DB_ROOT_PASSWORD=root_dev_pw

# --- API ---
CORS_ORIGIN=*

# --- Object storage (Cloudflare R2 in prod, MinIO locally) ---
# R2 prod: R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=portfolio-assets
R2_REGION=auto

# Public base URL the site uses for /work-clone/* assets.
# Empty = serve from the app bundle. Set to your R2 public URL / CDN to offload.
# e.g. https://assets.josbert.dev  (or  http://localhost:9000/portfolio-assets for local MinIO)
ASSET_BASE_URL=
